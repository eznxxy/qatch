{
  "name": "qatch",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome extension + web app for fast, context-rich bug reports",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @qatch/extension dev",
    "dev:web": "pnpm --filter @qatch/web dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @qatch/web db:generate",
    "db:migrate": "pnpm --filter @qatch/web db:migrate"
  }
}
