{
  "name": "@qatch/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Qatch Chrome extension (WXT + React, Manifest V3)",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@qatch/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
